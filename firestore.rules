rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem abriu o app (acesso anônimo) e conhece o endereço da casa
    // (que é derivado da chave da casa) consegue ler e gravar.
    // Não existe regra para listar /casas, então ninguém descobre casas alheias.
    match /casas/{casaId}/{colecao}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
